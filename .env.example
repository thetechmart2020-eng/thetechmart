# Copy this file to .env for local development (never commit the real .env).
# In production, set these same three as Environment Variables in your Vercel
# project settings instead — Vercel injects them automatically, no .env needed there.

# Supabase project settings > API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_KEY=YOUR-SERVICE-ROLE-KEY

# Any long random string — used to sign the admin login cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-random-string

# Optional — defaults to 3000 locally, ignored on Vercel
PORT=3000
